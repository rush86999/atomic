# Attempt-3 run artifacts are written by the runner while the server is
# serving the frozen candidate. Keep them out of the candidate's clean
# identity check; the committed evidence copy is checksummed separately.
attempt3_config.json
attempt3_result.json
attempt3_summary.json
attempt3_run.log
attempt3_server_*.log
attempt3_observation_*.jsonl
attempt3_interpreter_freeze.txt
attempt3_*.tmp

# Attempt-4 artifacts are new names so the controlled run cannot
# overwrite the preserved attempt-3 evidence. They are archived after the
# single run (git add -f) and checksummed separately.
attempt4_config.json
attempt4_result.json
attempt4_summary.json
attempt4_run.log
attempt4_server_*.log
attempt4_observation_*.jsonl
attempt4_interpreter_freeze.txt
attempt4_preflight.json
attempt4_*.tmp
# Attempt-5 successor artifacts (unlaunched). New names again so the
# corrected harness cannot overwrite attempt 3/4 evidence.
attempt5_config.json
attempt5_result.json
attempt5_summary.json
attempt5_run.log
attempt5_server_*.log
attempt5_observation_*.jsonl
attempt5_interpreter_freeze.txt
attempt5_preflight.json
attempt5_*.tmp
